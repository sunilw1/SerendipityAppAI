# Serendipity AI Backend - Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=serendipity-ai-backend
APP_ENV=development
DEBUG=true
API_VERSION=v1

# =============================================================================
# SERVER SETTINGS
# =============================================================================
HOST=0.0.0.0
PORT=8000
WORKERS=4

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# MySQL connection
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/serendipity
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# =============================================================================
# DATA INGESTION SETTINGS
# =============================================================================
# Path to dataset directory
DATASET_PATH=../dataset
RAW_DATA_FILE=trips-500-for-different_users.csv

# Ingestion batch size for streaming processing
INGESTION_BATCH_SIZE=1000
MAX_RECORDS_PER_REQUEST=10000

# =============================================================================
# CONFIDENCE SCORING SETTINGS
# =============================================================================
# Physical constraint thresholds
MAX_REALISTIC_SPEED_MS=100.0  # ~360 km/h (high-speed rail)
MAX_REALISTIC_ACCELERATION_MS2=15.0  # ~1.5g
MIN_GPS_ACCURACY_METERS=3.0
MAX_GPS_ACCURACY_METERS=100.0

# Time gap thresholds (seconds)
MIN_UPDATE_INTERVAL_SECONDS=0.5
MAX_UPDATE_GAP_SECONDS=300  # 5 minutes

# =============================================================================
# BASELINE LEARNING SETTINGS
# =============================================================================
# Minimum data requirements for baseline
MIN_TRIPS_FOR_BASELINE=5
MIN_POINTS_FOR_BASELINE=100

# Update frequency
BASELINE_REFRESH_INTERVAL_HOURS=24

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout

# =============================================================================
# NVIDIA / GPU SETTINGS (Phase 2+)
# =============================================================================
# Set to true when GPU acceleration is available
CUDA_ENABLED=false
TENSORRT_ENABLED=false

# Triton Inference Server (Phase 2+)
TRITON_URL=localhost:8001
TRITON_MODEL_REPOSITORY=/models

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# API Key for internal services (generate a secure random key)
API_SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# STORAGE SETTINGS
# =============================================================================
# S3 configuration for model artifacts
S3_BUCKET=serendipity-models
S3_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
